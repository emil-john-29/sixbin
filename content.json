{
  "updatedAt": "2026-11-18",
  "releaseDate": "2026-11-19",
  "news": [
    {
      "date": "2026-11-18T11:00:00Z",
      "text": "GTA VI ist da: Neuseeland durfte als erstes Land loslegen. Weltweit startet das Spiel jeweils um Mitternacht Ortszeit – in Deutschland in der Nacht auf den 19. November."
    },
    {
      "date": "2026-11-18T10:30:00Z",
      "text": "Rekord-Wertungen: Metacritic und OpenCritic stehen bei 99 von 100. IGN und GameSpot vergeben 10/10, GamePro 98 und GameStar 97 Punkte."
    },
    {
      "date": "2026-11-18T10:00:00Z",
      "text": "Achtung vor Fake-Cheats: Die meisten „GTA 6 Cheat“-Listen im Netz sind alte GTA-V-Codes. Bestätigte Cheats gibt es noch keine – in SixBin erscheinen nur geprüfte Codes."
    },
    {
      "date": "2026-11-16T12:00:00Z",
      "text": "Zweites Day-One-Update (01.002.001) wird in Wellen verteilt – auf der PS5 rund 600 MB. Das erste Update 1.002 kam am 13. November."
    },
    {
      "date": "2026-11-12",
      "text": "Pre-Load für digitale Vorbestellungen ist gestartet."
    },
    {
      "date": "2026-11-10",
      "text": "Bestätigt: Zum Start gibt es keinen Online-Modus – GTA VI ist zunächst ein reines Einzelspieler-Spiel."
    }
  ],
  "infos": [
    {
      "title": "Release",
      "text": "Seit 18. November in Neuseeland, weltweit jeweils um Mitternacht Ortszeit. In Deutschland in der Nacht auf den 19. November."
    },
    {
      "title": "Plattformen",
      "text": "PlayStation 5 und Xbox Series X|S. Eine PC-Version kommt später, ein Datum gibt es noch nicht."
    },
    {
      "title": "Wertungen",
      "text": "Metacritic 99, OpenCritic 99 (100 % Empfehlungen). IGN 10/10, GameSpot 10/10, GamePro 98, GameStar 97."
    },
    {
      "title": "Technik",
      "text": "Läuft auf allen Konsolen mit 30 Bildern pro Sekunde – auch auf der PS5 Pro. Laut neuseeländischem Netzbetreiber Chorus ist das Spiel rund 212 GB groß."
    },
    {
      "title": "Spielzeit",
      "text": "Story etwa 60–80 Stunden. Für die 100-%-Checkliste kommen rund 100 Stunden dazu, für die Platin-Trophäe insgesamt etwa 200 Stunden."
    },
    {
      "title": "Trophäen",
      "text": "55 Trophäen: 1 Platin, 2 Gold, 6 Silber, 46 Bronze. Alles offline, kein Online-Modus und kein DLC nötig. Nur eine Trophäe ist möglicherweise verpassbar."
    },
    {
      "title": "Hauptfiguren",
      "text": "Jason Duval und Lucia Caminos – ein Gangster-Duo. Viele Überfälle lassen sich allein oder zu zweit machen."
    },
    {
      "title": "Spielwelt",
      "text": "Der Bundesstaat Leonida, angelehnt an Florida, mit Vice City als Metropole und fünf weiteren Regionen. Alle Orte findest du in der Datenbank und auf der Karte."
    },
    {
      "title": "Handy-Apps",
      "text": "Auf dem Handy gibt es Parodien echter Apps, u. a. Snapmatic (Social Media), WhatUp (Chat), RydeMe (Fahrdienst), WAiNK (Scannen), Scooter Bros und BuckMe."
    },
    {
      "title": "Schnellreise",
      "text": "Bus, Bahn, Tram, Taxi oder per RydeMe einen Fahrer rufen."
    },
    {
      "title": "Überfälle",
      "text": "Von kleinen Läden über Juweliere, Pfandleiher und Payday-Kredithaie bis zu Banken, Geldtransportern und großen Heists."
    },
    {
      "title": "Online-Modus",
      "text": "Zum Start nicht dabei. Berichte erwarten ihn 2027 – offiziell ist das nicht."
    }
  ],
  "tips": [
    {
      "tag": "Trophäen",
      "title": "Meditation in Kapitel 1 nicht verpassen",
      "text": "Die einzige möglicherweise verpassbare Trophäe ist „Positive Mental Attitude“. Der erste Meditationsplatz bei Jason zu Hause ist nur in Kapitel 1 verfügbar – also gleich mitnehmen.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Trophäen",
      "title": "Cheats kosten Trophäen",
      "text": "Cheats deaktivieren laut Trophäen-Guides die Trophäen. Wer auf Platin spielt, sollte vorher speichern oder ganz verzichten.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "100 %",
      "title": "Fortschritt zählt von Anfang an",
      "text": "Die 100-%-Checkliste (Fortschritt > Statistiken > 100 % Abschluss) siehst du erst nach der Story. Alles, was du vorher erledigst, zählt aber schon mit – und nichts davon ist verpassbar.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "100 %",
      "title": "Fahrzeuge früh scannen",
      "text": "Für 100 % musst du 200 der 277 Basismodelle mit der WAiNK-App scannen. Mach es dir zur Gewohnheit, jedes neue Auto im Vorbeifahren zu scannen.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "100 %",
      "title": "Tiere beobachten statt jagen",
      "text": "Für 100 % reicht es, 100 der 255 Tierarten mit dem Fernglas zu studieren. Jagen ist nur für Brets Aufträge nötig (nur mit Jason).",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Überfälle",
      "title": "Banken ab Kapitel 3",
      "text": "Bankjobs werden erst im Laufe von Kapitel 3 freigeschaltet. Vorher lohnen sich Läden, Pfandleiher und Juweliere.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Einsteiger",
      "title": "Vorher Platz schaffen",
      "text": "Das Spiel ist über 200 GB groß. Prüfe, ob genug Speicher frei ist, und lade die Day-One-Updates direkt mit.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Einsteiger",
      "title": "Spoiler vermeiden",
      "text": "In den ersten Tagen kursieren viele Story-Videos und Fake-Missionslisten. Schalte Empfehlungen auf YouTube & TikTok im Zweifel stumm, bis du durch bist.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Einsteiger",
      "title": "Mehrere Speicherstände",
      "text": "Speichere regelmäßig in verschiedenen Slots. So kannst du zurück, falls du eine Entscheidung bereust oder dich verbuggst."
    },
    {
      "tag": "Einsteiger",
      "title": "Einstellungen anpassen",
      "text": "Nimm dir fünf Minuten für Steuerung, Zielhilfe, Untertitel und Minikarte. Das macht gerade in den ersten Stunden viel aus."
    }
  ],
