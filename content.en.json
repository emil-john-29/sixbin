{
  "updatedAt": "2026-11-18",
  "releaseDate": "2026-11-19",
  "news": [
    {
      "date": "2026-11-18T11:00:00Z",
      "text": "GTA VI is here: New Zealand got to play first. Worldwide, the game unlocks at midnight local time in each region."
    },
    {
      "date": "2026-11-18T10:30:00Z",
      "text": "Record scores: Metacritic and OpenCritic are at 99/100. IGN and GameSpot gave it 10/10, GamePro 98 and GameStar 97."
    },
    {
      "date": "2026-11-18T10:00:00Z",
      "text": "Beware of fake cheats: most “GTA 6 cheat” lists online are old GTA V codes. There are no confirmed cheats yet – SixBin only shows verified codes."
    },
    {
      "date": "2026-11-16T12:00:00Z",
      "text": "A second day-one update (01.002.001) is rolling out in waves – about 600 MB on PS5. The first update, 1.002, arrived on November 13."
    },
    {
      "date": "2026-11-12",
      "text": "Pre-load for digital pre-orders has started."
    },
    {
      "date": "2026-11-10",
      "text": "Confirmed: there is no online mode at launch – GTA VI starts as a single-player game."
    }
  ],
  "infos": [
    {
      "title": "Release",
      "text": "Out since November 18 in New Zealand, worldwide at midnight local time on November 19."
    },
    {
      "title": "Platforms",
      "text": "PlayStation 5 and Xbox Series X|S. A PC version will come later, no date yet."
    },
    {
      "title": "Review scores",
      "text": "Metacritic 99, OpenCritic 99 (100% recommend). IGN 10/10, GameSpot 10/10, GamePro 98, GameStar 97."
    },
    {
      "title": "Tech",
      "text": "Runs at 30 frames per second on all consoles – including PS5 Pro. According to New Zealand network operator Chorus, the game is about 212 GB."
    },
    {
      "title": "Playtime",
      "text": "Story about 60–80 hours. The 100% checklist adds roughly 100 hours; the Platinum takes about 200 hours in total."
    },
    {
      "title": "Trophies",
      "text": "55 trophies: 1 Platinum, 2 Gold, 6 Silver, 46 Bronze. All offline, no online mode or DLC needed. Only one trophy is potentially missable."
    },
    {
      "title": "Main characters",
      "text": "Jason Duval and Lucia Caminos – a criminal duo. Many robberies can be done solo or together."
    },
    {
      "title": "Game world",
      "text": "The state of Leonida, inspired by Florida, with Vice City as its metropolis and five more regions. Find all places in the database and on the map."
    },
    {
      "title": "Phone apps",
      "text": "The phone features parodies of real apps, including Snapmatic (social media), WhatUp (chat), RydeMe (ride-hailing), WAiNK (scanning), Scooter Bros and BuckMe."
    },
    {
      "title": "Fast travel",
      "text": "Bus, train, tram, taxi – or call a driver with RydeMe."
    },
    {
      "title": "Robberies",
      "text": "From small stores, jewelers, pawn shops and payday lenders to banks, armored trucks and big heists."
    },
    {
      "title": "Online mode",
      "text": "Not included at launch. Reports expect it in 2027 – not official."
    }
  ],
  "tips": [
    {
      "tag": "Trophies",
      "title": "Don't miss the meditation in Chapter 1",
      "text": "The only potentially missable trophy is “Positive Mental Attitude”. The first meditation spot at Jason's house is only available in Chapter 1 – do it right away.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Trophies",
      "title": "Cheats cost trophies",
      "text": "According to trophy guides, cheats disable trophies. If you're going for Platinum, save first or skip them.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "100 %",
      "title": "Progress counts from the start",
      "text": "You can only view the 100% checklist (Progress > Stats > 100% Completion) after the story. Everything you do before still counts – and none of it is missable.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "100 %",
      "title": "Scan vehicles early",
      "text": "For 100% you need to scan 200 of the 277 base models with the WAiNK app. Make it a habit to scan every new car you pass.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "100 %",
      "title": "Observe animals, don't hunt",
      "text": "For 100% it's enough to study 100 of the 255 animal species with binoculars. Hunting is only needed for Bret's jobs (Jason only).",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Robberies",
      "title": "Banks from Chapter 3",
      "text": "Bank jobs unlock during Chapter 3. Before that, stores, pawn shops and jewelers are worth it.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Beginners",
      "title": "Free up space first",
      "text": "The game is over 200 GB. Make sure you have enough storage and grab the day-one updates right away.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Beginners",
      "title": "Avoid spoilers",
      "text": "In the first days, lots of story videos and fake mission lists are going around. Consider muting recommendations on YouTube & TikTok until you're done.",
      "added": "2026-11-18T10:00:00Z"
    },
    {
      "tag": "Beginners",
      "title": "Use multiple saves",
      "text": "Save regularly in different slots so you can go back if you regret a decision or run into a bug."
    },
    {
      "tag": "Beginners",
      "title": "Tweak your settings",
      "text": "Take five minutes for controls, aim assist, subtitles and minimap. It makes a big difference in the first hours."
    }
  ],
